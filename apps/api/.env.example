INTERVIEWIQ_DB_URL=jdbc:mysql://localhost:3307/interviewiq
INTERVIEWIQ_DB_USERNAME=<local-db-username>
INTERVIEWIQ_DB_PASSWORD=<local-db-password>
INTERVIEWIQ_JWT_SECRET=<local-development-jwt-secret>
INTERVIEWIQ_AI_API_KEY=<local-development-ai-api-key>
INTERVIEWIQ_AI_PROVIDER=deterministic
INTERVIEWIQ_AI_MODEL=gemini-2.5-flash
INTERVIEWIQ_AI_TIMEOUT_SECONDS=20
INTERVIEWIQ_AI_MAX_ATTEMPTS=2
INTERVIEWIQ_CORS_ALLOWED_ORIGIN=http://localhost:5173
